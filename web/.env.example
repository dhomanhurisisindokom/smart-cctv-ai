# Copy to .env and fill in (or run: sh ../deploy/init-env.sh).

# ---- Database ----
# Default: container ../sqlserver (host "sqlserver" in jaringan Docker smartcctv_mini).
# Untuk SQL Server lain, ganti DB_HOST/DB_PORT/DB_USER (lihat juga ../sqlserver/.env untuk migration).
DB_HOST=sqlserver
DB_PORT=1433
DB_NAME=smartcctv_mini
DB_USER=sa
DB_PASSWORD=

# ---- Shared with ../fastapi/.env (generate each with: openssl rand -hex 32) ----
MINI_INGEST_TOKEN=
MINI_STREAM_KEY=

# ---- Foto bukti ----
# db  = disimpan di database (default)
# file = disimpan sebagai file JPEG. Ke NAS: aktifkan COMPOSE_FILE di bawah dan isi NAS_*.
EVIDENCE_STORAGE=db
# COMPOSE_PATH_SEPARATOR=:
# COMPOSE_FILE=docker-compose.yml:docker-compose.nas.yml
# NAS_SHARE=//r2folder.pep.pertamina.com/share/BS/IT/IT_DAMA/_All/14_PROJECT/CCTV AI/CCTV_EVIDENCE
# NAS_ADDR=10.12.2.90
# NAS_DOMAIN=PERTAMINA
# NAS_USER=
# NAS_PASSWORD=
# NAS_SMB_VERSION=3.0

# ---- Web / AI addresses ----
# Browser address of the AI service. Empty = same host as the web page, port AI_PUBLIC_PORT.
# AI_PUBLIC_URL=http://10.12.21.10:8090
# AI_PUBLIC_PORT=8090
# WEB_PORT=8091
