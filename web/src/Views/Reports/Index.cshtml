@model ReportsModel
@{
    ViewBag.Title = "Laporan & Analitik";
    ViewBag.Active = "reports";
    var s = Model.Summary;
    var q = new { range = Model.Range, from = Model.From.ToString("yyyy-MM-dd"), to = Model.To.ToString("yyyy-MM-dd") };
    var apdPct = s.Total == 0 ? 0 : 100.0 * s.Apd / s.Total;
    var vehPct = s.Total == 0 ? 0 : 100.0 * s.Vehicle / s.Total;
    var maxArea = Model.Areas.Count == 0 ? 1 : Math.Max(1, Model.Areas.Max(a => Math.Max(a.Apd, a.Vehicle)));
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}
<div class="page-head" style="display:flex;align-items:flex-start;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:24px;">
  <div>
    <h2>Laporan &amp; Analitik</h2>
    <p>Tren pelanggaran dan performa penanganan kasus.</p>
  </div>
  <div style="display:flex;gap:9.6px;flex-wrap:wrap;">
    <a class="btn-secondary" style="text-decoration:none" href="@Url.Action("Summary", q)">Unduh Ringkasan Eksekutif</a>
    <a class="btn-primary" style="text-decoration:none" href="@Url.Action("Detail", q)">Unduh Laporan Detail</a>
  </div>
</div>

<form method="get" action="@Url.Action("Index")" style="display:flex;align-items:center;flex-wrap:wrap;gap:12px;margin-bottom:24px;">
  <div style="display:flex;gap:8px;flex-wrap:wrap;">
    <a class="range-pill@(Model.Range == "7d" ? " active" : "")" style="text-decoration:none" href="@Url.Action("Index", new { range = "7d" })">7 Hari</a>
    <a class="range-pill@(Model.Range == "30d" ? " active" : "")" style="text-decoration:none" href="@Url.Action("Index", new { range = "30d" })">30 Hari</a>
    <a class="range-pill@(Model.Range == "all" ? " active" : "")" style="text-decoration:none" href="@Url.Action("Index", new { range = "all" })">Semua Waktu</a>
  </div>
  <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
    <input type="hidden" name="range" value="custom">
    <label for="from" style="font-size:13.1px;color:#61686F;">Dari</label>
    <input id="from" name="from" type="date" class="date" value="@Model.From.ToString("yyyy-MM-dd")">
    <label for="to" style="font-size:13.1px;color:#61686F;">s/d</label>
    <input id="to" name="to" type="date" class="date" value="@Model.To.ToString("yyyy-MM-dd")">
    <button type="submit" class="btn-secondary">Terapkan</button>
  </div>
</form>

<div class="kpi-grid" style="grid-template-columns:repeat(auto-fit,minmax(170px,1fr))">
  <div class="kpi"><div class="label">Total Pelanggaran</div><div class="value">@Fmt.Number(s.Total)</div></div>
  <div class="kpi"><div class="label">Rata-rata / Hari</div><div class="value">@Fmt.Number((double)s.Total / Math.Max(1, Model.Days), 1)</div></div>
  <div class="kpi"><div class="label">Dijadikan Kasus</div><div class="value">@Fmt.Number(s.Cases)</div></div>
  <div class="kpi"><div class="label">Kasus Selesai</div><div class="value" style="color:#3F7612;">@(s.Cases == 0 ? "–" : Fmt.Number(100.0 * s.CasesDone / s.Cases) + "%")</div></div>
  <div class="kpi"><div class="label">Rata-rata Waktu Respons</div><div class="value">@(s.AvgResponseMinutes.HasValue ? Fmt.Number(s.AvgResponseMinutes.Value, 1) : "–")<span class="unit"> mnt</span></div></div>
</div>
<p style="font-size:12.5px;color:#61686F;margin:-8px 0 24px;">"Total Pelanggaran" = semua deteksi AI. "Dijadikan Kasus", "Kasus Selesai", dan "Rata-rata Waktu Respons" (deteksi → dijadikan kasus) hanya menghitung alert yang dipromosikan jadi Case Violation.</p>

<section class="panel" style="padding:20px 24px;margin-bottom:20px;">
  <h2 style="font-size:14.7px;font-weight:600;margin:0 0 16px;">Distribusi per Kategori</h2>
  <div style="display:flex;border-radius:100px;overflow:hidden;height:10px;margin-bottom:18.4px;background:#EEF0F2">
    <div style="width:@apdPct.ToString("0.#", inv)%;background:#B57712;"></div>
    <div style="width:@vehPct.ToString("0.#", inv)%;background:#B8021F;"></div>
  </div>
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:20px;">
    <div style="display:flex;align-items:center;gap:12px;">
      <div style="width:35px;height:35px;border-radius:8px;background:#FBF1DF;display:flex;align-items:center;justify-content:center;"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#B57712" stroke-width="1.8" aria-hidden="true"><path d="M4 15.5V15a8 8 0 0 1 16 0v0.5"/><rect x="3" y="15.5" width="18" height="3" rx="1.2"/><path d="M12 6.5v2.2"/></svg></div>
      <div><div style="font-size:13.6px;font-weight:600;">APD Detection</div><div style="font-size:12.6px;color:#61686F;margin-top:1.6px;"><span class="mono" style="font-weight:700;color:#171A1D;">@Fmt.Number(s.Apd)</span> pelanggaran · @Fmt.Number(apdPct, 1)% dari total</div></div>
    </div>
    <div style="display:flex;align-items:center;gap:12px;">
      <div style="width:35px;height:35px;border-radius:8px;background:#FBE3E3;display:flex;align-items:center;justify-content:center;"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#B8021F" stroke-width="1.8" aria-hidden="true"><rect x="2" y="6" width="11" height="10" rx="1"/><path d="M13 10h4l3 3v3h-7z"/><circle cx="6.5" cy="18" r="1.8"/><circle cx="17" cy="18" r="1.8"/></svg></div>
      <div><div style="font-size:13.6px;font-weight:600;">Vehicle Violation</div><div style="font-size:12.6px;color:#61686F;margin-top:1.6px;"><span class="mono" style="font-weight:700;color:#171A1D;">@Fmt.Number(s.Vehicle)</span> pelanggaran · @Fmt.Number(vehPct, 1)% dari total</div></div>
    </div>
  </div>
</section>

<section class="panel" style="padding:20px 24px;margin-bottom:20px;">
  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;gap:12px;flex-wrap:wrap;">
    <h2 style="font-size:14.7px;font-weight:600;margin:0;">Tren Pelanggaran <span style="font-weight:400;color:#61686F;">(per hari@(Model.Days > 31 ? ", 31 hari terakhir" : ""))</span></h2>
    <div style="display:flex;gap:19px;">
      <span class="legend"><i style="background:#B57712;"></i>APD Detection</span>
      <span class="legend"><i style="background:#B8021F;"></i>Vehicle Violation</span>
    </div>
  </div>
  @Html.Raw(BarChart.Bars(Model.Trend, 240, "Tren pelanggaran per hari per kategori"))
</section>

<section class="panel">
  <div class="panel-head"><h2>Pelanggaran per Kamera &amp; Lokasi</h2></div>
  @if (Model.Areas.Count == 0)
  {
    <div class="empty">Tidak ada pelanggaran pada rentang ini.</div>
  }
  else
  {
  <div class="table-wrap">
    <table>
      <thead><tr><th>Kamera</th><th>Lokasi</th><th>Kategori</th><th style="width:260px;">Jumlah</th></tr></thead>
      <tbody>
      @foreach (var a in Model.Areas)
      {
        foreach (var cat in new[] { "vehicle", "apd" })
        {
          var n = cat == "apd" ? a.Apd : a.Vehicle;
          if (n == 0) { continue; }
          var color = cat == "apd" ? "#B57712" : "#B8021F";
          <tr>
            <td style="font-weight:600;">@a.Camera</td><td style="color:#61686F;">@a.Location</td>
            <td><span class="badge @(cat == "apd" ? "b-apd" : "b-veh")">@(cat == "apd" ? "APD" : "Vehicle") @Fmt.Number(n)</span></td>
            <td><div style="display:flex;align-items:center;gap:9.6px;"><div class="track"><div style="width:@((100.0 * n / maxArea).ToString("0.#", inv))%;background:@color;"></div></div><span class="mono" style="font-size:13.6px;font-weight:600;min-width:29px;text-align:right;">@Fmt.Number(n)</span></div></td>
          </tr>
        }
      }
      </tbody>
    </table>
  </div>
  }
</section>
