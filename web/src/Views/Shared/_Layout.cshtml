@{
    var user = (SessionUser)ViewBag.User;
    var active = (string)ViewBag.Active ?? "";
    Func<string, string> nav = key => key == active ? "nav active" : "nav";
}
<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>@ViewBag.Title — Smart CCTV AI</title>
<link rel="icon" href="@Url.Content("~/Content/logo.jpg")">
<link rel="stylesheet" href="@Url.Content("~/Content/styles.css")">
</head>
<body data-root="@Url.Content("~/")">
<div style="min-height:100%;background:#F5F6F7;">
  <header class="hdr">
    <div class="brand">
      <img src="@Url.Content("~/Content/logo.jpg")" alt="Pertamina EP">
      <div class="divider"></div>
      <div>
        <h1>Smart CCTV AI</h1>
        <div class="sub">Safety &amp; Vehicle Violation Detection</div>
      </div>
    </div>
    <div class="hdr-right">
      <span class="pill">@user.RoleLabel</span>
      <div class="user-chip">
        <div class="avatar">@user.Initials</div>
        <span class="uname">@user.FullName</span>
        @using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { @class = "inline" }))
        {
          @Html.AntiForgeryToken()
          <button type="submit" class="logout" style="font-family:inherit;cursor:pointer">Keluar</button>
        }
      </div>
    </div>
    <div class="hdr-bar"></div>
  </header>
  <div class="layout">
    <nav class="sidebar" aria-label="Menu utama">
      <div class="nav-label first">Overview</div>
      <a class="@nav("dashboard")" href="@Url.Action("Index", "Home")"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg><span>Dashboard</span></a>
      <div class="nav-label">Deteksi</div>
      <a class="@nav("apd")" href="@Url.Action("Index", "Apd")"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 15.5V15a8 8 0 0 1 16 0v0.5"/><rect x="3" y="15.5" width="18" height="3" rx="1.2"/><path d="M12 6.5v2.2"/></svg><span>APD Detection</span></a>
      <a class="@nav("vehicle")" href="@Url.Action("Index", "Vehicle")"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="2" y="6" width="11" height="10" rx="1"/><path d="M13 10h4l3 3v3h-7z"/><circle cx="6.5" cy="18" r="1.8"/><circle cx="17" cy="18" r="1.8"/></svg><span>Vehicle Violation</span></a>
      <div class="nav-label">Operasional</div>
      <a class="@nav("cases")" href="@Url.Action("Index", "Cases")"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M9 3h6a1 1 0 0 1 1 1v1H8V4a1 1 0 0 1 1-1z"/><rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 12.5l2 2 4-4.5"/></svg><span>Case Violation</span></a>
      <a class="@nav("reports")" href="@Url.Action("Index", "Reports")"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="M4 19V11"/><path d="M10 19V5"/><path d="M16 19v-7"/><path d="M4 19h16"/></svg><span>Laporan &amp; Analitik</span></a>
      @if (user.IsAdmin)
      {
      <div class="nav-label">Platform</div>
      <a class="@nav("settings")" href="@Url.Action("Index", "Settings")"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><line x1="4" y1="6" x2="20" y2="6"/><circle cx="9" cy="6" r="1.8" fill="#fff"/><line x1="4" y1="12" x2="20" y2="12"/><circle cx="15" cy="12" r="1.8" fill="#fff"/><line x1="4" y1="18" x2="20" y2="18"/><circle cx="7" cy="18" r="1.8" fill="#fff"/></svg><span>Pengaturan</span></a>
      <a class="@nav("admin")" href="@Url.Action("Index", "Admin")"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg><span>Manajemen User</span></a>
      }
    </nav>
    <main class="main">
      @if (TempData["Flash"] != null)
      {
        <div class="flash @((TempData["FlashOk"] as bool?) == false ? "err" : "ok")">@TempData["Flash"]</div>
      }
      @RenderBody()
    </main>
  </div>
</div>

@* Shared popup: case detail and camera view are loaded into it. *@
<div class="modal-bg" id="modal" role="dialog" aria-modal="true"><div class="modal" id="modal-box"></div></div>
<form id="af">@Html.AntiForgeryToken()</form>
@RenderSection("Scripts", required: false)
<script src="@Url.Content("~/Content/app.js")"></script>
</body>
</html>
