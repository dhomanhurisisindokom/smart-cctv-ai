# Copy to .env and fill in. Same MSSQL_SA_PASSWORD goes into ../fastapi/.env and ../web/.env.
# SQL Server rule: >= 8 characters with upper, lower, digit and symbol.
MSSQL_SA_PASSWORD=
MINI_DB=smartcctv_mini
# First admin account (created only when there are no users yet).
MINI_ADMIN_USERNAME=admin
MINI_ADMIN_PASSWORD=
# MINI_SQL_PORT=14330
# MSSQL_MEMORY_LIMIT_MB=2048
