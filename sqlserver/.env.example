# Copy to .env and fill in (or run: sh ../deploy/init-env.sh).
# SQL Server rule: >= 8 characters with upper, lower, digit and symbol.
MSSQL_SA_PASSWORD=
# MSSQL_MEMORY_LIMIT_MB=2048
# MINI_SQL_PORT=14330

# ---- Migration target (default: container sqlserver di atas, login sa) ----
DB_NAME=smartcctv_mini
# DB_HOST=sqlserver
# DB_PORT=1433
# DB_USER=sa
# DB_PASSWORD=          # kosong = MSSQL_SA_PASSWORD

# First admin account (created only when there are no users yet).
MINI_ADMIN_USERNAME=admin
MINI_ADMIN_PASSWORD=
