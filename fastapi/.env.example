# Copy to .env and fill in. Same values as ../web/.env. Generate each with: openssl rand -hex 32
MINI_INGEST_TOKEN=
MINI_STREAM_KEY=

# First install only: these cameras are copied into the web while it has no cameras yet.
# Afterwards cameras are managed in the web (menu Pengaturan) and these lines are ignored.
CCTV_1_URL='rtsp://user:password@camera-1/Streaming/Channels/101'
CCTV_1_NAME='CCTV 1'
# CCTV_1_APD_MASK=masks/posluar_1080p.json
# CCTV_1_VEHICLE_PROFILE=pos_arah_luar_1080p
CCTV_2_URL='rtsp://user:password@camera-2/Streaming/Channels/101'
CCTV_2_NAME='CCTV 2'

# API_PORT=8090
# Without a GPU the same image runs on CPU (INFERENCE_DEVICE defaults to cpu; ~0.5 samples/s).
